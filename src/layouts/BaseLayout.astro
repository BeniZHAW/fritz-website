---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileOrderBar from '../components/MobileOrderBar.astro';
import CartToast from '../components/CartToast.astro';
import { SITE, withBase } from '../config/site';
import fontUrl from '../assets/fonts/Rushcaps-Regular.woff?url';

interface Props {
  title?: string;
  description?: string;
  /** Auf der Startseite liegt das Formular auf derselben Seite. */
  isHome?: boolean;
}

const { title, description = SITE.description, isHome = false } = Astro.props;
const fullTitle = title ? `${title} – ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('/og-image.jpg'), Astro.site);
/** Vorschau auf GitHub Pages: nicht in Suchmaschinen aufnehmen. */
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <slot name="head" />
  </head>
  <body class:list={{ 'is-home': isHome }}>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <SiteHeader isHome={isHome} />
    <main id="inhalt">
      <slot />
    </main>
    <SiteFooter />
    <MobileOrderBar isHome={isHome} />
    <CartToast />
    <script>
      import '../scripts/cart-ui';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--color-yellow);
    color: var(--color-on-yellow);
    font-weight: 700;
    border-radius: var(--radius-sm);
  }

  .skip-link:focus {
    top: var(--space-4);
  }
</style>
