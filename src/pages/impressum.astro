---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Impressum & Datenschutz" description="Impressum und Datenschutzerklärung von FRITZ Gewürze, Muri AG.">
  <PageHero eyebrow="Rechtliches" title="Impressum & Datenschutz" />

  <!-- Text unveraendert von pommes-fritz.ch/impressum.php uebernommen -->
  <article class="container legal">

      <h2>Verantwortliche Stelle</h2>
      <p>
        FRITZ Gewürze<br />
        CH-5630 Muri<br />
      </p>

      <h2>Kontakt</h2>
      <p>
        E-Mail: <a href="mailto:hoi@pommes-fritz.ch">hoi@pommes-fritz.ch</a>
      </p>

      <h2>Haftungsausschluss</h2>
      <p>
        Die Betreiber dieser Website übernehmen keine Gewähr für die Richtigkeit,
        Vollständigkeit und Aktualität der Inhalte. Haftungsansprüche gegen die
        Betreiber wegen Schäden materieller oder immaterieller Art, die aus dem
