---
interface Props {
  items: { id: string; label: string }[];
}

const { items } = Astro.props;
---

<nav class="progress-dots" aria-label="Die vier Gründe" data-progress-dots>
  <ol>
    {
      items.map((item, i) => (
        <li>
          <a href={`#${item.id}`} data-progress-dot={i + 1}>
            <span class="sr-only">{item.label}</span>
            <span class="progress-dots__label" aria-hidden="true">
              {item.label}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .progress-dots {
    position: fixed;
    right: var(--space-5);
    top: 50%;
    z-index: var(--z-bar);
    transform: translateY(-50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms;
  }

  .progress-dots.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  ol {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    position: relative;
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid rgb(255 255 255 / 0.5);
    transition:
      background-color var(--duration),
      border-color var(--duration),
      transform var(--duration) var(--ease-out);
  }

  a:global(.is-active) {
    background: var(--color-yellow);
    border-color: var(--color-yellow);
    transform: scale(1.3);
  }

  .progress-dots__label {
    position: absolute;
    right: 24px;
    top: 50%;
    translate: 0 -50%;
    white-space: nowrap;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-yellow);
    opacity: 0;
    transition: opacity var(--duration);
  }

  a:hover .progress-dots__label,
  a:global(.is-active) .progress-dots__label {
    opacity: 1;
  }

  @media (max-width: 1100px) {
    .progress-dots {
      display: none;
    }
  }
</style>
