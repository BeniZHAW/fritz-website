---
import { Image } from 'astro:assets';
import doseImg from '../../assets/images/produkt-dose.jpg';
import nachfuellerImg from '../../assets/images/produkt-nachfueller.jpg';
import { withBase } from '../../config/site';
import { MAX_QTY_PER_PRODUCT, PRODUCTS, formatCHF, type ProductId } from '../../config/shop';

const thumbs: Record<ProductId, ImageMetadata> = { dose: doseImg, nachfueller: nachfuellerImg };

const fields = [
  { id: 'firstName', label: 'Vorname', autocomplete: 'given-name', type: 'text', half: true },
  { id: 'lastName', label: 'Name', autocomplete: 'family-name', type: 'text', half: true },
  { id: 'email', label: 'E-Mail', autocomplete: 'email', type: 'email', half: false },
  { id: 'phone', label: 'Telefon', autocomplete: 'tel', type: 'tel', half: false },
  { id: 'street', label: 'Strasse und Nr.', autocomplete: 'street-address', type: 'text', half: false },
  { id: 'zip', label: 'PLZ', autocomplete: 'postal-code', type: 'text', half: true, pattern: '[0-9]{4}', inputmode: 'numeric', maxlength: 4 },
  { id: 'city', label: 'Ort', autocomplete: 'address-level2', type: 'text', half: true },
] as const;
---

<section id="bestellen" class="order" aria-labelledby="bestellen-title">
  <div class="container">
    <header class="order__head">
      <span class="eyebrow">Bestellen</span>
      <h2 id="bestellen-title" class="order__title">Dein FRITZ wartet schon.</h2>
      <p class="lead">Bestellen, Mail mit TWINT-Link erhalten, bezahlen. Wir verschicken von Hand aus Muri.</p>
    </header>

    <form class="order__form" data-order-form novalidate>
      <fieldset class="order__card order__products">
        <legend class="order__legend">1 · Deine Bestellung</legend>
        {
          PRODUCTS.map((product) => (
            <div class="line">
              <Image src={thumbs[product.id]} alt="" width={56} class="line__thumb" />
              <div class="line__meta">
                <label for={`qty-${product.id}`} class="line__name">
                  {product.name}
                </label>
                <span class="line__note">
                  {formatCHF(product.price)} · {product.shippingNote}
                </span>
              </div>
              <div class="stepper">
                <button type="button" class="stepper__btn" data-step={product.id} data-delta="-1" aria-label={`${product.name}: eins weniger`}>
                  −
                </button>
                <input
                  id={`qty-${product.id}`}
                  name={`qty-${product.id}`}
                  type="number"
                  inputmode="numeric"
                  min="0"
                  max={MAX_QTY_PER_PRODUCT}
                  value="0"
                  data-qty={product.id}
                />
                <button type="button" class="stepper__btn" data-step={product.id} data-delta="1" aria-label={`${product.name}: eins mehr`}>
                  +
                </button>
              </div>
            </div>
          ))
        }

        <dl class="summary" aria-live="polite">
          <div><dt>Zwischensumme</dt><dd data-sum="subtotal">CHF 0.00</dd></div>
          <div><dt>Versand</dt><dd data-sum="shipping">CHF 0.00</dd></div>
          <div class="summary__total"><dt>Total</dt><dd data-sum="total">CHF 0.00</dd></div>
        </dl>
        <p class="hint" data-shipping-hint hidden></p>
        <p class="order__error" data-products-error hidden>Bitte wähle mindestens ein Produkt.</p>
      </fieldset>

      <fieldset class="order__card order__address">
        <legend class="order__legend">2 · Lieferadresse</legend>
        <div class="fields">
          {
            fields.map((f) => (
              <div class:list={['field', { 'field--half': f.half }]}>
                <label for={f.id}>{f.label}</label>
                <input
                  id={f.id}
                  name={f.id}
                  type={f.type}
                  autocomplete={f.autocomplete}
                  required
                  pattern={'pattern' in f ? f.pattern : undefined}
                  inputmode={'inputmode' in f ? f.inputmode : undefined}
                  maxlength={'maxlength' in f ? f.maxlength : undefined}
                  aria-describedby={`${f.id}-error`}
                />
                <span class="field__error" id={`${f.id}-error`} />
              </div>
            ))
          }
          <div class="field">
            <label for="note">Bemerkung <span class="optional">(optional)</span></label>
            <textarea id="note" name="note" rows="3" maxlength="500"></textarea>
          </div>

          <div class="field field--honeypot" aria-hidden="true">
            <label for="website">Webseite</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="field field--check">
            <input id="acceptedTerms" name="acceptedTerms" type="checkbox" required aria-describedby="acceptedTerms-error" />
            <label for="acceptedTerms">
              Ich habe die <a href={withBase('/impressum#datenschutz')} target="_blank">Datenschutzerklärung</a> gelesen und bin
              einverstanden.
            </label>
            <span class="field__error" id="acceptedTerms-error"></span>
          </div>
        </div>

        <button type="submit" class="btn btn--primary order__submit" data-submit>
          Verbindlich bestellen
        </button>
        <p class="order__twint">
          Nach der Bestellung erhältst du per E-Mail deinen persönlichen <strong>TWINT-Link</strong> zur Zahlung.
        </p>
        <p class="order__error" data-submit-error role="alert" hidden></p>
      </fieldset>
    </form>

    <div class="order__success" data-order-success hidden tabindex="-1">
      <span class="order__success-icon" aria-hidden="true">✓</span>
      <h3 data-success-title>Merci!</h3>
      <p data-success-text></p>
      <p class="order__prototype" data-success-prototype hidden>
        Prototyp: Diese Bestellung wurde <strong>nicht</strong> gesendet. Später geht sie direkt ins ERP.
      </p>
      <button type="button" class="btn btn--ghost" data-order-reset>Neue Bestellung</button>
    </div>
  </div>
</section>

<script>
  import { calcTotals, formatCHF, freeShippingHint, PRODUCTS, type ProductId } from '../../config/shop';
  import { clearCart, getCart, onCartChange, setQty } from '../../scripts/cart';
  import { submitOrder, type OrderRequest } from '../../scripts/order-api';

  const form = document.querySelector<HTMLFormElement>('[data-order-form]');
  const success = document.querySelector<HTMLElement>('[data-order-success]');

  if (form && success) {
    const qtyInputs = form.querySelectorAll<HTMLInputElement>('[data-qty]');
    const sum = (key: string) => form.querySelector<HTMLElement>(`[data-sum="${key}"]`);
    const hint = form.querySelector<HTMLElement>('[data-shipping-hint]');
    const productsError = form.querySelector<HTMLElement>('[data-products-error]');
    const submitError = form.querySelector<HTMLElement>('[data-submit-error]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');

    const render = () => {
      const cart = getCart();
      qtyInputs.forEach((input) => {
        const value = String(cart[input.dataset.qty as ProductId]);
        if (input.value !== value) input.value = value;
      });
      const totals = calcTotals(cart);
      sum('subtotal')!.textContent = formatCHF(totals.subtotal);
      sum('shipping')!.textContent = totals.shipping === 0 && totals.itemCount > 0 ? 'gratis' : formatCHF(totals.shipping);
      sum('total')!.textContent = formatCHF(totals.total);
      const hintText = freeShippingHint(cart);
      if (hint) {
        hint.hidden = !hintText;
        hint.textContent = hintText ?? '';
        hint.classList.toggle('hint--done', hintText === 'Gratisversand');
      }
      if (productsError && totals.itemCount > 0) productsError.hidden = true;
    };

    form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.step as ProductId;
        setQty(id, getCart()[id] + Number(btn.dataset.delta), 'form');
      });
    });

    qtyInputs.forEach((input) => {
      input.addEventListener('change', () => setQty(input.dataset.qty as ProductId, Number(input.value), 'form'));
    });

    const messageFor = (input: HTMLInputElement): string => {
      const v = input.validity;
      if (v.valueMissing) return input.type === 'checkbox' ? 'Bitte bestätigen.' : 'Bitte ausfüllen.';
      if (v.typeMismatch && input.type === 'email') return 'Bitte eine gültige E-Mail-Adresse eingeben.';
      if (v.patternMismatch && input.name === 'zip') return 'Bitte eine Schweizer PLZ mit 4 Ziffern eingeben.';
      return '';
    };

    const validateField = (input: HTMLInputElement): boolean => {
      const error = form.querySelector<HTMLElement>(`#${input.id}-error`);
      const msg = input.checkValidity() ? '' : messageFor(input);
      if (error) error.textContent = msg;
      input.setAttribute('aria-invalid', String(msg !== ''));
      return msg === '';
    };

    const requiredInputs = form.querySelectorAll<HTMLInputElement>('input[required]');
    requiredInputs.forEach((input) => {
      input.addEventListener('blur', () => validateField(input));
      input.addEventListener('input', () => input.getAttribute('aria-invalid') === 'true' && validateField(input));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitError) submitError.hidden = true;

      const cart = getCart();
      const totals = calcTotals(cart);
      let firstInvalid: HTMLElement | null = null;

      if (totals.itemCount === 0 && productsError) {
        productsError.hidden = false;
        firstInvalid = form.querySelector('[data-qty]');
      }
      requiredInputs.forEach((input) => {
        if (!validateField(input) && !firstInvalid) firstInvalid = input;
      });
      if (firstInvalid) {
        (firstInvalid as HTMLElement).focus();
        return;
      }

      const data = new FormData(form);
      const text = (key: string) => String(data.get(key) ?? '').trim();
      const order: OrderRequest = {
        customer: {
          firstName: text('firstName'),
          lastName: text('lastName'),
          email: text('email'),
          phone: text('phone'),
          street: text('street'),
          zip: text('zip'),
          city: text('city'),
        },
        items: PRODUCTS.filter((p) => cart[p.id] > 0).map((p) => ({ productId: p.id, quantity: cart[p.id] })),
        note: text('note'),
        acceptedTerms: data.get('acceptedTerms') === 'on',
        website: text('website'),
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Wird gesendet …';
      }
      const result = await submitOrder(order);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Verbindlich bestellen';
      }

      if (!result.ok) {
        if (submitError) {
          submitError.textContent = result.message;
          submitError.hidden = false;
        }
        return;
      }

      const lines = order.items
        .map((item) => `${item.quantity}× ${PRODUCTS.find((p) => p.id === item.productId)?.name}`)
        .join(', ');
      success.querySelector('[data-success-title]')!.textContent = `Merci, ${order.customer.firstName}!`;
      success.querySelector('[data-success-text]')!.textContent =
        `${lines} für ${formatCHF(totals.total)}. Die Bestätigung mit deinem TWINT-Link kommt an ${order.customer.email}.`;
      success.querySelector<HTMLElement>('[data-success-prototype]')!.hidden = !result.prototype;
      form.hidden = true;
      success.hidden = false;
      success.focus();
      form.reset();
      clearCart();
    });

    success.querySelector('[data-order-reset]')?.addEventListener('click', () => {
      success.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLElement>('[data-qty]')?.focus();
    });

    render();
    onCartChange(render);
  }
</script>

<style>
  .order {
    padding-block: var(--section-y);
    background: var(--color-bg-alt);
    border-top: 4px solid var(--color-yellow);
  }

  .order__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .order__title {
    font-size: var(--text-2xl);
    color: var(--color-yellow);
  }

  .order__form {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-6);
    align-items: start;
  }

  .order__card {
    margin: 0;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    min-width: 0;
  }

  .order__products {
    position: sticky;
    top: calc(var(--header-h-compact) + var(--space-4));
  }

  .order__legend {
    float: left;
    width: 100%;
    margin-bottom: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text);
  }

  .line {
    clear: both;
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .line :global(.line__thumb) {
    width: 56px;
    height: 72px;
    object-fit: contain;
    background: #000;
    border-radius: var(--radius-sm);
  }

  .line__meta {
    display: grid;
  }

  .line__name {
    font-weight: 700;
  }

  .line__note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .stepper {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
  }

  .stepper__btn {
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: none;
    font-size: var(--text-lg);
    cursor: pointer;
  }

  .stepper__btn:hover {
    color: var(--color-yellow);
  }

  .stepper input {
    width: 2.6em;
    border: 0;
    background: none;
    text-align: center;
    font-weight: 700;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .stepper input::-webkit-inner-spin-button,
  .stepper input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .summary {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
  }

  .summary div {
    display: flex;
    justify-content: space-between;
  }

  .summary dt {
    color: var(--color-text-muted);
  }

  .summary dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .summary__total {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .summary__total dt {
    color: var(--color-text);
  }

  .hint {
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background: rgb(255 214 0 / 0.12);
    color: var(--color-yellow);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .hint::before {
    content: '🚚 ';
  }

  .hint--done {
    background: rgb(123 216 143 / 0.12);
    color: var(--color-success);
  }

  .fields {
    clear: both;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .field {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-1);
  }

  .field--half {
    grid-column: span 1;
  }

  .field label {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .optional {
    font-weight: normal;
    color: var(--color-text-subtle);
  }

  .field input:not([type='checkbox']),
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    transition: border-color var(--duration);
  }

  .field input:focus,
  .field textarea:focus {
    border-color: var(--color-yellow);
    outline: none;
  }

  .field input[aria-invalid='true'] {
    border-color: var(--color-danger);
  }

  .field__error {
    min-height: 1em;
    font-size: var(--text-xs);
    color: var(--color-danger);
  }

  .field__error:empty {
    display: none;
  }

  .field--check {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: var(--space-3);
  }

  .field--check input {
    width: 22px;
    height: 22px;
    margin-top: 2px;
    accent-color: var(--color-yellow);
  }

  .field--check label {
    font-weight: normal;
    color: var(--color-text-muted);
  }

  .field--check .field__error {
    grid-column: 2;
  }

  .field--honeypot {
    position: absolute;
    left: -10000px;
  }

  .order__submit {
    width: 100%;
    margin-top: var(--space-6);
    font-size: var(--text-lg);
  }

  .order__submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .order__twint {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }

  .order__error {
    margin-top: var(--space-3);
    color: var(--color-danger);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .order__success {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    max-width: 640px;
    margin-inline: auto;
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-yellow);
    text-align: center;
  }

  .order__success h3 {
    font-size: var(--text-2xl);
    color: var(--color-yellow);
  }

  .order__success-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-yellow);
    color: var(--color-on-yellow);
    font-size: 2rem;
    font-weight: 700;
  }

  .order__prototype {
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--color-yellow);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 960px) {
    .order__form {
      grid-template-columns: 1fr;
    }

    .order__products {
      position: static;
    }
  }

  @media (max-width: 520px) {
    .order__card {
      padding: var(--space-5) var(--space-4);
    }

    .line {
      grid-template-columns: 44px 1fr;
    }

    .line :global(.line__thumb) {
      width: 44px;
      height: 58px;
    }

    .stepper {
      grid-column: 1 / -1;
      justify-self: end;
    }

    .fields {
      grid-template-columns: 1fr;
    }

    .field--half {
      grid-column: 1 / -1;
    }
  }
</style>
