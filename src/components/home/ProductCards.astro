---
import { Image } from 'astro:assets';
import doseImg from '../../assets/images/produkt-dose.jpg';
import nachfuellerImg from '../../assets/images/produkt-nachfueller.jpg';
import moodImg from '../../assets/images/stimmung-dosen-nachfueller.jpg';
import { PRODUCTS, formatPriceShort, type ProductId } from '../../config/shop';

const images: Record<ProductId, { src: ImageMetadata; alt: string; tag: string }> = {
  dose: { src: doseImg, alt: 'FRITZ Paprika in der Alu-Dose', tag: 'Für den Start' },
  nachfueller: { src: nachfuellerImg, alt: 'FRITZ Paprika Nachfüllpackung aus Kraftpapier', tag: 'Für immer' },
};
---

<section id="produkte" class="products" aria-labelledby="produkte-title">
  <div class="products__banner">
    <Image src={moodImg} alt="" widths={[800, 1600, 2400]} sizes="100vw" class="products__banner-img" />
    <div class="container products__banner-text" data-reveal-from="bottom">
      <span class="eyebrow">Zwei Produkte. Mehr braucht es nicht.</span>
      <h2 id="produkte-title" class="products__title">Einmal Dose.<br />Für immer nachfüllen.</h2>
    </div>
  </div>

  <div class="container products__grid">
    {
      PRODUCTS.map((product) => {
        const image = images[product.id];
        return (
          <article class="product" data-reveal-from="bottom">
            <div class="product__media">
              <span class="product__tag">{image.tag}</span>
              <Image src={image.src} alt={image.alt} widths={[300, 600]} sizes="(max-width: 860px) 45vw, 260px" />
            </div>
            <div class="product__body">
              <h3 class="product__name">{product.name}</h3>
              <p class="product__variant">{product.variant}</p>
              <p class="product__price">
                <span class="sr-only">Preis: CHF</span>
                <span aria-hidden="true">CHF</span> {formatPriceShort(product.price)}
              </p>
              <p class="product__shipping">{product.shippingNote}</p>
              <button type="button" class="btn btn--primary" data-add-to-cart={product.id}>
                In den Warenkorb
              </button>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .products {
    padding-bottom: var(--section-y);
    background: var(--color-bg);
  }

  .products__banner {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(70vh, 640px);
    padding-block: var(--space-9) var(--space-8);
    overflow: hidden;
    isolation: isolate;
  }

  .products__banner :global(.products__banner-img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .products__banner::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, var(--color-bg) 0%, rgb(11 11 11 / 0.2) 60%, rgb(11 11 11 / 0.4));
  }

  .products__banner-text {
    display: grid;
    gap: var(--space-4);
  }

  .products__title {
    font-size: var(--text-2xl);
    color: var(--color-yellow);
  }

  .products__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    max-width: 960px;
  }

  .product {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: var(--space-5);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .product__media {
    position: relative;
    display: grid;
    place-items: center;
    padding: var(--space-6) var(--space-3) var(--space-3);
    border-radius: var(--radius-md);
    background: #000;
  }

  .product__media :global(img) {
    max-height: 240px;
    width: auto;
  }

  .product__tag {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-orange);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .product__body {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-2);
  }

  .product__name {
    font-size: var(--text-xl);
  }

  .product__variant,
  .product__shipping {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .product__price {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--color-yellow);
    line-height: 1;
  }

  .product__price span {
    font-size: 0.45em;
    vertical-align: super;
  }

  .product .btn {
    margin-top: var(--space-3);
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .products__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .product {
      grid-template-columns: 120px 1fr;
      gap: var(--space-4);
      padding: var(--space-4);
    }

    .product__media :global(img) {
      max-height: 170px;
    }
  }
</style>
