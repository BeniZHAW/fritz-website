---
/**
 * Argument 1: die natuerlichen Zutaten fliegen von den Raendern herein und legen sich um die Dose.
 * Prototyp: Ausschnitte aus dem bestehenden Zutaten-Foto. Shooting liefert freigestellte Zutaten.
 */
import { Image } from 'astro:assets';
import basilikum from '../../assets/images/zutat-basilikum.jpg';
import kartoffeln from '../../assets/images/zutat-kartoffeln.jpg';
import peperoni from '../../assets/images/zutat-peperoni-knoblauch.jpg';
import dose from '../../assets/images/zutat-dose.jpg';

const tiles = [
  { img: basilikum, alt: 'Frisches Basilikum', cls: 'tile--basilikum', fly: '-120,-80,-14' },
  { img: peperoni, alt: 'Rote Peperoni und Knoblauch', cls: 'tile--peperoni', fly: '130,-60,12' },
  { img: kartoffeln, alt: 'Kartoffeln', cls: 'tile--kartoffeln', fly: '-90,110,10' },
];
---

<div class="ingredients" data-ingredients>
  <span class="placeholder-badge">Platzhalter · Shooting</span>
  {
    tiles.map((t) => (
      <figure class:list={['tile', t.cls]} data-fly={t.fly}>
        <Image src={t.img} alt={t.alt} widths={[320, 640]} sizes="(max-width: 860px) 50vw, 25vw" />
      </figure>
    ))
  }
  <figure class="tile tile--dose" data-fly-center>
    <Image src={dose} alt="FRITZ Paprika-Dose" widths={[240, 480]} sizes="(max-width: 860px) 35vw, 16vw" />
  </figure>
</div>

<style>
  .ingredients {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 560px;
    margin-inline: auto;
    width: 100%;
  }

  .tile {
    position: absolute;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border);
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile--basilikum {
    top: 2%;
    left: 0;
    width: 52%;
    aspect-ratio: 724 / 508;
    rotate: -4deg;
  }

  .tile--peperoni {
    top: 10%;
    right: 0;
    width: 44%;
    aspect-ratio: 635 / 699;
    rotate: 5deg;
  }

  .tile--kartoffeln {
    bottom: 4%;
    left: 4%;
    width: 50%;
    aspect-ratio: 636 / 457;
    rotate: 3deg;
  }

  .tile--dose {
    z-index: 1;
    bottom: 0;
    left: 50%;
    width: 30%;
    aspect-ratio: 445 / 858;
    translate: -10% 0;
    border-color: var(--color-yellow);
  }
</style>
