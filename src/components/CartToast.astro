---
import { SITE } from '../config/site';
---

<div class="cart-toast" data-cart-toast role="status" aria-live="polite" hidden>
  <span class="cart-toast__icon" aria-hidden="true">✓</span>
  <span data-cart-toast-text>Im Warenkorb</span>
  <a href={SITE.orderAnchor} class="cart-toast__link">Zur Bestellung</a>
</div>

<style>
  .cart-toast {
    position: fixed;
    top: calc(var(--header-h) + var(--space-3));
    right: var(--space-4);
    z-index: var(--z-toast);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: calc(100vw - 2 * var(--space-4));
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    font-size: var(--text-sm);
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity var(--duration),
      transform var(--duration) var(--ease-out);
  }

  .cart-toast.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .cart-toast__icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-yellow);
    color: var(--color-on-yellow);
    font-weight: 700;
  }

  .cart-toast__link {
    margin-left: var(--space-2);
    font-weight: 700;
    color: var(--color-yellow);
    white-space: nowrap;
  }
</style>
